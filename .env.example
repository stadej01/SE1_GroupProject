# For the separate Neon accounts/teams demo only.
# Copy this file to .env in the repository root; never commit .env.
# Generate a strong secret key as described in README.md.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Copy the unpooled Neon connection URL, including sslmode=require.
DATABASE_URL=

# Private GitHub repository for each project's Markdown, as owner/name.
# Leave it empty to keep saved Markdown in server memory during local runs.
GITHUB_REPOSITORY=
# Fine-grained token with Contents read and write access to that repository only.
GITHUB_TOKEN=
GITHUB_BRANCH=main
