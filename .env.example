# Local development: configure your own Neon database and GitHub content repository.
# Copy this template to .env only when initializing a new environment.
# Generate DJANGO_SECRET_KEY once for your environment as described in README.md.
# Optional shared setup: use the supplied .env instead and keep its existing key.
# Never commit .env or real secrets.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
# Keep True locally to serve frontend files and use login cookies over HTTP.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Copy the unpooled Neon connection URL, including sslmode=require.
DATABASE_URL=

# Private GitHub repository for each project's Markdown, as owner/name.
# Fill in the repository and token for local runs and reopening saved projects.
GITHUB_REPOSITORY=
# Fine-grained token with Contents read and write access to that repository only.
GITHUB_TOKEN=
GITHUB_BRANCH=main
