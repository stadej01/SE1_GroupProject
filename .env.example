# Copy this file to .env in the repository root.
# Generate a local key using the command in README.md.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Neon PostgreSQL connection URL, including its TLS parameters.
# Example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=
